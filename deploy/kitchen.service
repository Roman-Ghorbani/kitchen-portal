[Unit]
Description=ZBT Kitchen Duty
After=network.target

[Service]
Type=simple
User=kitchen
WorkingDirectory=/srv/kitchen
EnvironmentFile=/srv/kitchen/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3

# The database lives outside the repo so a deploy can never touch it.
Environment=NODE_ENV=production
Environment=PORT=3000

# Basic hardening: the service can only write where it needs to.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/kitchen-data

[Install]
WantedBy=multi-user.target

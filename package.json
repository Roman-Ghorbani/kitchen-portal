{
  "name": "kitchen-portal",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Kitchen duty scheduling, late plates and menus for a fraternity chapter house. Next.js + SQLite on a Raspberry Pi behind a Cloudflare Tunnel.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "node scripts/test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "admin:credentials": "node scripts/admin-credentials.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}

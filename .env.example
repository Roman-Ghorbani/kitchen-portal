# -----------------------------------------------------------------------------
# Kitchen Portal configuration.
#
# On the Pi this file is .env.production (chmod 600, owned by the service
# user). For local development copy it to .env.local. Never commit either.
# Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# -----------------------------------------------------------------------------

# Public origin, used in Slack messages and calendar feeds.
NEXT_PUBLIC_APP_URL=https://kitchen.example.org

# SQLite database file. Defaults to ./data/kitchen.db.
DATABASE_FILE=

# REQUIRED. Signs session cookies, calendar links and setup-code hashes.
# At least 32 characters. Changing it signs everyone out and invalidates
# every calendar subscription and outstanding setup code.
SESSION_SECRET=

# REQUIRED. The kitchen manager's password as a scrypt hash, and the secret
# for his authenticator app. Generate both with:  npm run admin:credentials
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Read-only key for the house display on the Pi (sent as X-API-Key to
# /api/tv/schedule and /api/tv/late-plates). Set the same value as
# KITCHEN_PORTAL_API_KEY in the house-display service.
TV_API_KEY=

# Bearer token for the day-before reminder (/api/cron/reminder), called by
# the kitchen-portal-reminder systemd timer. The endpoint refuses without it.
CRON_SECRET=

# Optional. Slack incoming webhook for the day-before reminder.
SLACK_WEBHOOK_URL=

# Encrypts nightly backups (AES-256-GCM). Keep a copy in a password manager:
# without it a backup cannot be restored. When unset, backups are written
# unencrypted and leave this file out.
BACKUP_PASSPHRASE=
# Where backups go. Defaults to /mnt/usb-backup/kitchen-portal if the drive
# is mounted, otherwise ./backups.
BACKUP_DIR=
BACKUP_KEEP_DAYS=60

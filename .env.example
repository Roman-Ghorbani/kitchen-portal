# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored - never commit real values.
# ---------------------------------------------------------------------------

# Where the SQLite database file lives. Relative paths are from the app root.
# Leave unset to use ./data/kitchen.db
DATABASE_FILE=

# Signs brothers' session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your admin password. Only you use this; brothers sign in with a 4-digit PIN.
ADMIN_PASSWORD=

# Optional. Slack incoming webhook for #kitchen-duty. Without it, Slack
# notifications are skipped and everything else works normally.
SLACK_WEBHOOK_URL=

# Optional, phase 2. Unguessable path for the kitchen TV display,
# e.g. a random string - the display lives at /tv/<this value>.
TV_DISPLAY_TOKEN=

# Protects the automated Sunday chapter transition at /api/cron/chapter.
# Vercel sends this as a bearer token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Public URL of the deployed app, used in Slack links.
# e.g. https://zbt-kitchen.vercel.app
NEXT_PUBLIC_APP_URL=

# The kitchen tablet's key to the late-plate controls (step 3). A long random
# string baked into the tablet's bookmarked URL as ?device=<this>, so the chefs
# never have to log in. Not real security - anyone who reads the tablet's
# address bar has it - but the threat model is house pranks. Rotate if it
# leaks. Leave unset and token access is simply off; the endpoints still work
# for the admin session.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LATE_PLATE_DEVICE_TOKEN=

# Where to read the day's menu from. The kitchen TV Pi is the source of truth
# for menus (they are entered in its admin console), and the droplet reaches it
# over Tailscale. See docs/TAILNET.md.
# Leave unset and the menu section simply doesn't render.
#   MENU_SOURCE_URL=http://zbt-kitchen-tv:8080/api/menu
MENU_SOURCE_URL=

# Token for external apps to pull menu data from /api/menu.
# Pass via header 'Authorization: Bearer <token>', 'X-API-Key: <token>',
# 'X-Menu-Token: <token>', or query parameter '?token=<token>'.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MENU_API_TOKEN=

